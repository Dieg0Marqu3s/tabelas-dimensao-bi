let
    Fonte = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [ESTADO = _t, UF = _t, CAPITAL = _t, LATITUDE = _t, LONGITUDE = _t, PAIS = _t, ESTADO_UF = _t]),
    #"Tipo Alterado" = Table.TransformColumnTypes(Fonte,{{"LATITUDE", type number}, {"LONGITUDE", type number}}),
    Arredondado = Table.TransformColumns(#"Tipo Alterado",{{"LATITUDE", each Number.Round(_, 6), type number}, {"LONGITUDE", each Number.Round(_, 6), type number}})
in
    Arredondado
